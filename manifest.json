{
  "manifest_version": 3,
  "name": "LumaWeave",
  "version": "2.0.1",
  "minimum_chrome_version": "120",
  "description": "Weave light between your hands in Google Meet. Local tracking, color presets, energy-saving modes and an interactive preview.",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["storage"],
  "action": {
    "default_title": "LumaWeave settings",
    "default_popup": "popup/popup.html",
    "default_icon": { "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["src/bridge.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["https://meet.google.com/*"],
      "js": [
        "src/settings.js",
        "src/status.js",
        "src/clap.js",
        "src/particles.js",
        "src/weave.js",
        "src/lighting.js",
        "src/tracker.js",
        "src/audio-clap.js",
        "src/engine.js",
        "src/pipeline.js",
        "src/hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["detector/*", "vendor/*", "vendor/wasm/*"],
      "matches": ["https://meet.google.com/*"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
