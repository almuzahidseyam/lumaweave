{
  "manifest_version": 3,
  "name": "Meet Plexus",
  "version": "1.1.1",
  "description": "Double-clap on camera to draw glowing plexus lines between your fingertips in Google Meet. Double-clap again to turn it off.",
  "icons": { "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["storage"],
  "action": {
    "default_title": "Meet Plexus settings",
    "default_popup": "popup/popup.html",
    "default_icon": { "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["src/bridge.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["https://meet.google.com/*"],
      "js": [
        "src/settings.js",
        "src/status.js",
        "src/clap.js",
        "src/particles.js",
        "src/plexus.js",
        "src/lighting.js",
        "src/tracker.js",
        "src/audio-clap.js",
        "src/engine.js",
        "src/pipeline.js",
        "src/hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["detector/*", "vendor/*"],
      "matches": ["https://meet.google.com/*"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
